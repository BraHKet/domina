# Configurazione Mappa Domina
# Opzionale: Di default Domina utilizza i tile liberi e gratuiti di OpenStreetMap (nessuna chiave richiesta).

# Se desideri utilizzare provider professionali con stili personalizzati:
# 1. Carto Basemaps (Voyager / Positron / Dark Matter):
# VITE_MAP_API_KEY=la_tua_carto_api_key

# 2. Mapbox (stile Streets, Outdoors o Satellite):
# VITE_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/{z}/{x}/{y}?access_token=il_tuo_mapbox_token

# 3. Stadia Maps / Alidade Smooth:
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=la_tua_chiave
